# GA4 Debug Mode - logs all events to console
NEXT_PUBLIC_GA_DEBUG=false

# Registration API (Google Apps Script)
NEXT_PUBLIC_REGISTRATION_API_URL=

# Admin API (Google Apps Script)
NEXT_PUBLIC_ADMIN_API_URL=

# Google OAuth Client ID (for admin sign-in)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Competition team platform (server-only; never prefix with NEXT_PUBLIC_) ──
# The Apps Script web app URL (the same deployment as NEXT_PUBLIC_REGISTRATION_API_URL)
COMPETITION_API_URL=
# Shared signing secret, at least 32 characters; must equal EVSC_API_SECRET in Script Properties
# Generate with: openssl rand -hex 32
COMPETITION_API_SECRET=
# Signs team-leader sign-in cookies, at least 32 characters (a different value)
COMPETITION_SESSION_SECRET=
# Optional, local only: "local" runs the Apps Script against .data/competition-dev in `next start`.
# `next dev` uses the local backend automatically when COMPETITION_API_URL is not set.
# COMPETITION_DATA_BACKEND=local
